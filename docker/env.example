# Substitution variables for docker/compose.yaml and docker/compose.tunnel.yaml.
#
# Copy this file to docker/.env and fill in the values; Docker Compose reads a
# `.env` file from the compose file's directory automatically.

# Host directory mounted as /data/config. DevSpace reads config.jsonc from
# there; start from docker/config.example.jsonc. The variables below only seed
# that file when it does not exist yet, so edit the file for later changes. Use
# an absolute path when the stack runs outside this directory, for example in
# Portainer.
# DEVSPACE_CONFIG_DIR_HOST=./config

# Owner secret created by `devspace init` on a local install, or any random
# value of at least 16 characters. Generate one with: openssl rand -hex 32
DEVSPACE_OAUTH_OWNER_TOKEN=

# Host directory that is mounted as /workspaces inside the container.
DEVSPACE_PROJECTS_DIR=$HOME/projects

# Public hostname served by the tunnel that forwards to this container. Seeds
# server.publicBaseUrl on first start; set it whenever DevSpace is reached
# through anything other than localhost, because OAuth discovery advertises it.
# DEVSPACE_PUBLIC_BASE_URL=https://devspace.example.com

# Host address the container port is published on. Keep loopback and let the
# tunnel run on the host unless the network in front of it is trusted.
# DEVSPACE_BIND_ADDRESS=127.0.0.1

# Common overrides.
# Image channel: :latest (newest upstream release), :prerelease (newest
# prerelease), or :dev (upstream main plus this fork's patches).
# DEVSPACE_IMAGE=ghcr.io/ovlerfork/devspace:latest
# DEVSPACE_ALLOWED_ROOTS=/workspaces
# DEVSPACE_TOOL_MODE=codex
# DEVSPACE_WIDGETS=true
# DEVSPACE_LOG_LEVEL=info
# DEVSPACE_LOG_FORMAT=json

# cloudflared only; see docker/compose.tunnel.yaml. The tunnel is created and
# owned by you, not by DevSpace.
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_IMAGE=cloudflare/cloudflared:2026.9.1
